{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "app",
      "public": "build/hosting",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
          ]
        },
        {
          "source": "**/*.@(js|json|html)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/app/**",
          "destination": "/app/index.html"
        },
        {
          "source": "/webkit/**",
          "destination": "/webkit/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "old",
      "public": "tools/hosting-redirect",
      "redirects": [
        {
          "regex": "^/$",
          "destination": "https://yumsum.web.app/",
          "type": 301
        },
        {
          "regex": "^/(.*)$",
          "destination": "https://yumsum.web.app/:1",
          "type": 301
        }
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "lean-streak-project",
          "appId": "1:296684319013:android:7722c1ccb05bc21cdb6acc",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "lean-streak-project",
          "configurations": {
            "android": "1:296684319013:android:7722c1ccb05bc21cdb6acc",
            "ios": "1:296684319013:ios:34bb8e74ea1e98dddb6acc",
            "web": "1:296684319013:web:dc9c8e0064a127e9db6acc",
            "windows": "1:296684319013:web:cfa432a5adf4792cdb6acc"
          }
        }
      }
    }
  }
}
