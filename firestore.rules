rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function text(value, max) {
      return value is string && value.size() <= max;
    }

    function optionalText(value, max) {
      return value == null || text(value, max);
    }

    function optionalNumber(value) {
      return value == null || value is number;
    }

    // yyyy-MM-dd
    function dateKey(value) {
      return value is string && value.size() == 10;
    }

    function optionalDateKey(value) {
      return value == null || dateKey(value);
    }

    // The documents below are written whole (set, not update), so each lists
    // every field it may have. A new field in a model needs adding here too.

    // Fat, saturates, carbs, sugars, fibre and salt, in grams, on meals and
    // daily summaries.
    function optionalMacros(d) {
      return optionalNumber(d.get('fatGrams', null))
        && optionalNumber(d.get('saturatesGrams', null))
        && optionalNumber(d.get('carbsGrams', null))
        && optionalNumber(d.get('sugarsGrams', null))
        && optionalNumber(d.get('fibreGrams', null))
        && optionalNumber(d.get('saltGrams', null));
    }

    function validMeal(d) {
      return d.keys().hasOnly(['id', 'date', 'timestamp', 'name', 'calories',
                               'proteinGrams', 'createdAt', 'updatedAt',
                               'fatGrams', 'saturatesGrams', 'carbsGrams',
                               'sugarsGrams', 'fibreGrams', 'saltGrams'])
        && text(d.id, 100)
        && dateKey(d.date)
        && d.timestamp is timestamp
        && optionalText(d.get('name', null), 500)
        && d.calories is number
        && optionalNumber(d.get('proteinGrams', null))
        && optionalMacros(d)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function validSummary(d) {
      return d.keys().hasOnly(['date', 'totalCalories', 'targetCalories',
                               'calorieDelta', 'mealCount', 'proteinGrams',
                               'status', 'dayOff', 'updatedAt',
                               'fatGrams', 'saturatesGrams', 'carbsGrams',
                               'sugarsGrams', 'fibreGrams', 'saltGrams'])
        && dateKey(d.date)
        && d.totalCalories is number
        && d.targetCalories is number
        && d.calorieDelta is number
        && d.mealCount is number
        && optionalNumber(d.get('proteinGrams', null))
        && optionalMacros(d)
        && d.status in ['green', 'yellow', 'red']
        && d.get('dayOff', false) is bool
        && d.updatedAt is timestamp;
    }

    // The AI Coach's notes on a week, with the facts they were written from.
    function validReviewPoint(p) {
      return p is map
        && p.keys().hasOnly(['title', 'text', 'good'])
        && text(p.title, 80)
        && text(p.text, 600)
        && p.good is bool;
    }

    function validWeeklyReview(d) {
      return d.keys().hasOnly(['points', 'basis', 'createdAt'])
        && d.points is list
        && d.points.size() <= 8
        && (d.points.size() < 1 || validReviewPoint(d.points[0]))
        && (d.points.size() < 2 || validReviewPoint(d.points[1]))
        && (d.points.size() < 3 || validReviewPoint(d.points[2]))
        && (d.points.size() < 4 || validReviewPoint(d.points[3]))
        && (d.points.size() < 5 || validReviewPoint(d.points[4]))
        && (d.points.size() < 6 || validReviewPoint(d.points[5]))
        && (d.points.size() < 7 || validReviewPoint(d.points[6]))
        && (d.points.size() < 8 || validReviewPoint(d.points[7]))
        && text(d.basis, 12000)
        && d.createdAt is timestamp;
    }

    function validWeightEntry(d) {
      return d.keys().hasOnly(['dateKey', 'weightKg', 'loggedAt', 'source'])
        && dateKey(d.dateKey)
        && d.weightKg is number
        && d.loggedAt is timestamp
        && text(d.source, 20);
    }

    // The past-day edit counter only ever goes up by one; the AI functions
    // keep the AI allowance. The deleteAccount function deletes both with the
    // account.
    function counterCreate() {
      return request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
    }

    function counterIncrement() {
      return request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // A yyyy-MM key for the month at time t (UTC).
    function monthAt(month, t) {
      return int(month.replace('-', '')) == t.year() * 100 + t.month();
    }

    // The phone's month: the server's, give or take a day for time zones, so
    // changing the phone's date doesn't start a new count.
    function currentMonth(month) {
      return month.matches('[0-9]{4}-[0-9]{2}')
        && (monthAt(month, request.time - duration.value(1, 'd'))
          || monthAt(month, request.time)
          || monthAt(month, request.time + duration.value(1, 'd')));
    }

    match /users/{userId} {
      // The profile is set whole at onboarding and partly updated later, and
      // old profiles may carry fields the app no longer writes, so there is
      // no hasOnly: only the free-text fields and the switches and Adaptive
      // formula fields added since are checked.
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && text(request.resource.data.get('name', ''), 200)
        && text(request.resource.data.get('email', ''), 320)
        && text(request.resource.data.get('country', ''), 100)
        && text(request.resource.data.get('usualFood', ''), 500)
        && request.resource.data.get('trackProtein', true) is bool
        && request.resource.data.get('adaptiveKcal', 0) is number
        && optionalDateKey(request.resource.data.get('adaptiveWeek', null))
        && optionalDateKey(request.resource.data.get('adaptiveFrom', null))
        && optionalText(request.resource.data.get('adaptiveNote', null), 20)
        && request.resource.data.get('adaptiveChanges', []) is list
        && request.resource.data.get('adaptiveChanges', []).size() <= 6;

      match /meals/{mealId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validMeal(request.resource.data);
      }

      match /daily_summaries/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validSummary(request.resource.data);
      }

      match /weight_entries/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validWeightEntry(request.resource.data);
      }

      match /days_off/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['date'])
          && dateKey(request.resource.data.date);
      }

      match /weekly_reviews/{week} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && dateKey(week)
          && validWeeklyReview(request.resource.data);
      }

      // Counted by the AI's Cloud Functions before each call; the app only
      // reads it.
      match /ai_usage/{date} {
        allow read: if isOwner(userId);
      }

      match /day_edits/{month} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && currentMonth(month)
          && counterCreate();
        allow update: if isOwner(userId) && currentMonth(month)
          && counterIncrement();
      }

      // contribution_usage/{yyyy-MM-dd} and feedback_usage/{yyyy-MM-dd}
      // ({count}): the contributeProduct and sendFeedback functions' daily
      // limits. Only the functions read or write them, so there's no rule.

      // Legacy check-ins: no longer written, only deleted with the account.
      match /check_ins/{document=**} {
        allow read, delete: if isOwner(userId);
      }

      match /check_in_prompt_status/{document=**} {
        allow read, delete: if isOwner(userId);
      }
    }

    // YumSum+. Only the server (or the owner, by hand in the console)
    // writes it, so the app can read its own and nothing more.
    match /entitlements/{userId} {
      allow read: if isOwner(userId);
    }
  }
}
