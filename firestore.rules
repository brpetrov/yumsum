rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{document=**} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Feedback: the "Trigger Email from Firestore" extension emails each new
    // document here. Users may only create one addressed to the support inbox,
    // with their own email to reply to; nobody can read, change or delete them.
    match /mail/{id} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['to', 'replyTo', 'message'])
        && request.resource.data.to == 'help.yumsum@gmail.com'
        && request.resource.data.replyTo == request.auth.token.email
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasOnly(['subject', 'text'])
        && request.resource.data.message.subject == 'YumSum feedback'
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() <= 4000;
    }
  }
}
