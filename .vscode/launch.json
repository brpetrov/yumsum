    {
      "name": "YumSum (Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "R5CX205WQNV"
      ]
    },
    {
      "name": "YumSum (Android, contribute dry run)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "R5CX205WQNV",
        "--dart-define=OFF_DRY_RUN=true"
      ]
    }
  ]
